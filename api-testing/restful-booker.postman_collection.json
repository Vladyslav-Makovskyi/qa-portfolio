            ],
            "url": {
              "raw": "{{baseUrl}}/booking?firstname={{firstname}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ],
              "query": [
                {
                  "key": "firstname",
                  "value": "{{firstname}}"
                }
              ]
            }
          }
