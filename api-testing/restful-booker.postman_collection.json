                  "});",
                  "pm.test(\"Search returns the created booking\", () => {",
                  "    const ids = pm.response.json().map(x => x.bookingid);",
                  "    pm.expect(ids).to.include(pm.collectionVariables.get(\"bookingId\"));",
                  "});",
                  "pm.test(\"Response time is under 2000 ms\", () => {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
