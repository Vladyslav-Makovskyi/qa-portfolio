{
  "info": {
    "name": "Restful Booker - API tests",
    "description": "Practice API testing of the public training API https://restful-booker.herokuapp.com (it contains intentional defects). Positive checks must pass. Failing negative checks document real defects, see bug-reports/.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://restful-booker.herokuapp.com"
    }
  ],
  "item": [
    {
      "name": "1. Health check",
      "item": [
        {
          "name": "GET /ping - service is up",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// API docs describe 201 Created for this endpoint",
                  "pm.test(\"Status is 201\", () => {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response time is under 2000 ms\", () => {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ping",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ping"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Positive",
      "item": [
        {
          "name": "GET /booking - list of bookings",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response is a non-empty array of booking ids\", () => {",
                  "    const ids = pm.response.json();",
                  "    pm.expect(ids).to.be.an(\"array\").that.is.not.empty;",
                  "    pm.expect(ids[0]).to.have.property(\"bookingid\");",
                  "});",
                  "pm.test(\"Response time is under 2000 ms\", () => {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            }
          }
        },
        {
          "name": "POST /booking - create valid booking",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Unique first name for every run, so the search test finds exactly our booking",
                  "pm.collectionVariables.set(\"firstname\", \"QA\" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const res = pm.response.json();",
                  "const sent = JSON.parse(pm.request.body.raw.replace(\"{{firstname}}\", pm.collectionVariables.get(\"firstname\")));",
                  "pm.test(\"Response has numeric bookingid\", () => {",
                  "    pm.expect(res.bookingid).to.be.a(\"number\");",
                  "});",
                  "pm.test(\"Saved booking equals sent data\", () => {",
                  "    pm.expect(res.booking).to.eql(sent);",
                  "});",
                  "// Save id for the next requests (request chaining)",
                  "pm.collectionVariables.set(\"bookingId\", res.bookingid);",
                  "pm.test(\"Response time is under 2000 ms\", () => {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"{{firstname}}\",\n  \"lastname\": \"Brown\",\n  \"totalprice\": 150,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2026-12-01\",\n    \"checkout\": \"2026-12-05\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "GET /booking/{id} - read created booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Booking data matches what was created\", () => {",
                  "    const b = pm.response.json();",
                  "    pm.expect(b.firstname).to.eql(pm.collectionVariables.get(\"firstname\"));",
                  "    pm.expect(b.totalprice).to.eql(150);",
                  "    pm.expect(b.bookingdates).to.eql({ checkin: \"2026-12-01\", checkout: \"2026-12-05\" });",
                  "});",
                  "pm.test(\"Response time is under 2000 ms\", () => {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            }
          }
        },
        {
          "name": "GET /booking?firstname= - search by name",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => {",
